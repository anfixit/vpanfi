# Public port bound only to localhost. Reverse proxy will publish the domain.
VPANFI_PORT=8080
VPANFI_ENVIRONMENT=production
VPANFI_FRONTEND_ORIGIN=https://example.com

# Generate unique values before deployment.
POSTGRES_PASSWORD=change-me
VPANFI_JWT_SECRET=change-me-with-at-least-64-random-characters

# Added to the api service when the Remnawave panel is connected.
VPANFI_REMNAWAVE_BASE_URL=https://panel.example.com
VPANFI_REMNAWAVE_API_TOKEN=replace-with-panel-api-token

# User-facing support link.
VITE_TELEGRAM_SUPPORT_URL=https://t.me/VPaNfi_bot

# Frontend uses its built-in safe demo data until the backend is ready.
VITE_DEMO_MODE=true
VITE_API_BASE_URL=/api
