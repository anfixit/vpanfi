# Public port bound only to localhost. Reverse proxy publishes the domain.
VPANFI_PORT=8080
VPANFI_ENVIRONMENT=production

# Browser origins allowed to call the API. Comma-separated, no trailing slash.
VPANFI_FRONTEND_ORIGIN=https://example.com,https://www.example.com

# Generate unique values before deployment:
#   openssl rand -hex 32   -> POSTGRES_PASSWORD
#   openssl rand -hex 64   -> VPANFI_JWT_SECRET
# The API refuses to start in production with the placeholder secret or
# with anything shorter than 32 characters.
POSTGRES_PASSWORD=change-me
VPANFI_JWT_SECRET=change-me-with-at-least-64-random-characters

# Added to the api service when the Remnawave panel is connected.
# Leave both empty to keep the cabinet in demo mode.
VPANFI_REMNAWAVE_BASE_URL=https://panel.example.com
VPANFI_REMNAWAVE_API_TOKEN=replace-with-panel-api-token

# Bot that sells subscriptions and sends the subscription link.
VITE_TELEGRAM_BOT_URL=https://t.me/VPaNfi_bot

# Human support contact. Defaults to the bot when unset — set it to a
# personal account so "Написать в Telegram" reaches a person.
VITE_TELEGRAM_SUPPORT_URL=https://t.me/VPaNfi_bot

# Frontend uses its built-in demo data until the backend is ready.
# Demo mode never simulates a real payment: it only previews the screen.
VITE_DEMO_MODE=true
VITE_API_BASE_URL=/api
