# Public port bound only to localhost. Reverse proxy publishes the domain.
VPANFI_PORT=8080
VPANFI_ENVIRONMENT=production

# Browser origins allowed to call the API. Comma-separated, no trailing slash.
VPANFI_FRONTEND_ORIGIN=https://example.com,https://www.example.com

# Generate unique values before deployment:
#   openssl rand -hex 32   -> POSTGRES_PASSWORD
#   openssl rand -hex 64   -> VPANFI_JWT_SECRET
# The API refuses to start in production with the placeholder secret or
# with anything shorter than 32 characters.
POSTGRES_PASSWORD=change-me
VPANFI_JWT_SECRET=change-me-with-at-least-64-random-characters

# Added to the api service when the Remnawave panel is connected.
# Leave both empty to keep the cabinet in demo mode.
VPANFI_REMNAWAVE_BASE_URL=https://panel.example.com
VPANFI_REMNAWAVE_API_TOKEN=replace-with-panel-api-token

# Почта. Единственный канал, который переживает оплату по СБП: она
# заканчивается в приложении банка, и вкладку с результатом человек чаще
# всего теряет. Реквизиты — того же ящика, что у бота.
VPANFI_SMTP_HOST=
VPANFI_SMTP_PORT=2525
VPANFI_SMTP_USER=
VPANFI_SMTP_PASSWORD=
VPANFI_SMTP_FROM_EMAIL=
VPANFI_SMTP_FROM_NAME=VPaNfi

# Касса сайта: ЮKassa. Адрес уведомлений указывается в кабинете ЮKassa и
# должен вести на /api/v1:
# https://vpanfi.su/api/v1/payments/yookassa/webhook
VPANFI_YOOKASSA_SHOP_ID=
VPANFI_YOOKASSA_SECRET_KEY=
# Способы оплаты на выбор покупателю — это payment_method_data.type из
# API ЮKassa (bank_card, sbp, yoo_money, sberbank, tinkoff_bank). Пусто
# означает «не выбирать за человека»: ЮKassa сама покажет всё, что
# включено у магазина, и выключенный способ так не предложишь.
VPANFI_YOOKASSA_PAYMENT_METHODS=
# Сайт не только ждёт уведомление, но и спрашивает кассу сам: на
# странице результата и фоновым обходом своих неоплаченных платежей.
# Адрес уведомлений у магазина один, а магазин общий с ботом продаж;
# без опроса пропавшее уведомление оставило бы оплаченную подписку
# невыданной. Как часто идёт обход и сколько часов от создания платежа
# его ещё стоит спрашивать.
VPANFI_PAYMENT_POLL_MINUTES=5
VPANFI_PAYMENT_POLL_HOURS=24

# Прежняя касса. Оставлена до первого удачного боевого платежа через
# ЮKassa, чтобы откат был возможен.
VPANFI_PLATEGA_MERCHANT_ID=
VPANFI_PLATEGA_SECRET=

# Referral program. Off by default: while false, the site behaves exactly
# as before, the referral code is not stored and no rewards are granted.
# The token comes from the sales bot (Bedolaga) and may be left empty;
# an empty value is treated as not configured.
VPANFI_REFERRAL_ENABLED=false
# Мост к боту продаж: друг может купить подписку в боте, а не на сайте,
# и награда всё равно заводится. Выключен по умолчанию и требует ещё и
# VPANFI_REFERRAL_ENABLED=true и заполненного токена ниже.
VPANFI_REFERRAL_BOT_ENABLED=false
VPANFI_BEDOLAGA_API_TOKEN=

# Bot that sells subscriptions and sends the subscription link. Unrelated
# to the login bot above: this one is just a link shown to visitors.
VITE_TELEGRAM_BOT_URL=https://t.me/VPaNfi_bot

# Human support contact. Defaults to the bot when unset — set it to a
# personal account so "Написать в Telegram" reaches a person.
VITE_TELEGRAM_SUPPORT_URL=https://t.me/Anfikus

# Ways to sign in to the cabinet. Each one is independent: a provider
# without credentials is simply not offered on the sign-in screen.
#
# These only establish identity. A subscription never arrives through
# them — it is linked solely by its own subscription link.
#
# The login bot is NOT the bot that sells subscriptions. It needs its
# token, its username, and the domain registered with BotFather
# (/setdomain).
VPANFI_TELEGRAM_LOGIN_BOT_TOKEN=
VPANFI_TELEGRAM_LOGIN_BOT_USERNAME=
# VK ID application: id and secure key.
VPANFI_VK_CLIENT_ID=
VPANFI_VK_CLIENT_SECRET=
# Yandex OAuth application: client id and secret.
VPANFI_YANDEX_CLIENT_ID=
VPANFI_YANDEX_CLIENT_SECRET=
# Where providers return the visitor. Defaults to the first allowed
# origin plus /auth/callback, which is what the frontend serves.
VPANFI_OAUTH_REDIRECT_URL=

# Frontend uses its built-in demo data until the backend is ready.
# Demo mode never simulates a real payment: it only previews the screen.
VITE_DEMO_MODE=true
VITE_API_BASE_URL=/api
