# Public application
VPANFI_PUBLIC_URL=https://example.com
VPANFI_TELEGRAM_SUPPORT_URL=https://t.me/example
VPANFI_DEMO_MODE=true

# Remnawave adapter (server-side only)
REMNAWAVE_BASE_URL=https://panel.example.com
REMNAWAVE_API_TOKEN=replace_me
REMNAWAVE_SUBSCRIPTION_PUBLIC_URL=https://sub.example.com

# Authentication
AUTH_SECRET=replace_with_64_random_characters
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=

# Payments
PAYMENT_PROVIDER=mock
SBP_MERCHANT_ID=
SBP_SECRET_KEY=
SBP_WEBHOOK_SECRET=

# Database and cache
DATABASE_URL=postgresql://vpanfi:change_me@postgres:5432/vpanfi
REDIS_URL=redis://redis:6379/0

# Future AI support adapter
AI_SUPPORT_ENABLED=false
AI_SUPPORT_API_URL=
AI_SUPPORT_API_KEY=
